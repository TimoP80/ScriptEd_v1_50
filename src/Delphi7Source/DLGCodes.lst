   97  (* End of Arbitrary Code *)
   98  
   99  IGNORE CASE
  100  
  101  CHARACTERS
  102    letter   = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz" .
  103    digit    = "0123456789" .
  104    hexdigit = digit + "ABCDEFabcdef" .
  105    tab      = CHR(9) .
  106    lf       = CHR(10) .
  107    eol      = CHR(13) .
  108    files    = letter + digit + ":\." .
  109    chars    = CHR(32) .. CHR(255) - "'" .
  110    strings  = CHR(32) .. CHR(255) - '"'.
  111    macros   = ANY - eol .
  112  
  113  COMMENTS FROM "/*" TO "*/"
  114  
  115  IGNORE
  116    tab + eol + lf
  117  
  118  TOKENS
  119    identifier = ( "_" | letter) { "_" | letter | digit } .
  120    number     = digit { digit } [ "." { digit }] [ "U" | "u" | "L" | "l" ] .
  121    hexnumber  = "0" ( "x" | "X" ) hexdigit { hexdigit } [ "U" | "u" | "L" | "l" ] .
  122    _string     = '"' { strings } '"' .
  123    char       = "'" [ "\" ] chars "'" .
  124    _library    = "<" files { files } ">" .
  125  
  126  IGNORE CHR(1)..CHR(32)
  127  
  128  PRODUCTIONS
  129  
  130  UsageDefinition = ("pc" | "npc") (.writeln('USAGE:',lexstring) .).
  131  operator = ("<"|">"|"+"|"-") (.writeln('operator: ',lexstring); .).
  132  operators = "{" operator {"," operator} "}".
  133  
  134  ResultCode= "ResultCode" _string (. writeln('result code: ',parse_string(lexstring) );.) "usage" "=" "(" UsageDefinition {"," UsageDefinition} ")" "description"
  135  "=" _string (.writeln('description: ',parse_string(lexstring) ); .) "params" "=" number (.writeln('number of params: ',lexstring); .) "format" "=" "(" "cmd" [operators] ["param1"] ["param2"] ")" ";".
  136  
  137  DLGCodes = ResultCode {ResultCode}.
  138                                                                  
  139  END DLGCodes.
