   53  function parse_string(zstr: string): string;
   54  var t:    integer;
   55  var temp: string;
   56  var len:  integer;
   57  begin;
   58  result:='';
   59    len := 0;
   60  temp:='';
   61    //writeln ('Parsing string: ',zstr);
   62    t   := pos('"', zstr) + 1;
   63    len := length(zstr);
   64    while (zstr[t] <> '"') do
   65    begin;
   66      //writeln (zstr[t]);
   67      if (zstr[t] = '\') and (zstr[t + 1] = '"') then
   68      begin;
   69        temp := temp + '"';
   70        Inc(t, 1);
   71      end else
   72      if (zstr[t] = '\') and (zstr[t + 1] = '\') then
   73      begin;
   74        temp := temp + '\';
   75        Inc(t, 1);
   76      end else
   77      if (zstr[t] = '\') and (zstr[t + 1] = 't') then
   78      begin;
   79        temp := temp + #9;
   80        Inc(t, 1);
   81      end else
   82      if (zstr[t] = '\') and (zstr[t + 1] = 'n') then
   83      begin;
   84        temp := temp + #13#10;
   85        Inc(t, 1);
   86      end else
   87  
   88        temp := temp + zstr[t];
   89  
   90      Inc(t);
   91    end;
   92    Result := temp;
   93  end;
   94  
   95  
