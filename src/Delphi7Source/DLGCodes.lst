   27  const
   28    PadLen = 20;
   29                          
   30  function PadR(S : string; Ch : char; L : integer) : string;
   31  var
   32    i : integer;
   33  begin
   34    for i := 1 to L - (Length(s)) do
   35      s := s + Ch;
   36    Result := s;
   37  end;
