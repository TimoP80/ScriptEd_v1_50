  22 : Result := '"PARAMS" expected';
  23 : Result := '"FORMAT" expected';
  24 : Result := '"CMD" expected';
  25 : Result := '"PARAM1" expected';
  26 : Result := '"PARAM2" expected';
  27 : Result := '";" expected';
  28 : Result := 'not expected';
  29 : Result := 'invalid operator';
  30 : Result := 'invalid UsageDefinition';


  else
    if Assigned(OnCustomError) then
      Result := OnCustomError(Self, ErrorCode, Data)
    else
    begin
      Result := 'Error: ' + IntToStr(ErrorCode);
      if Trim(Data) > '' then
        Result := Result + ' (' + Data + ')';
    end;
  end;  {case nr}
end; {ErrorStr}

procedure TDLGCodes.Execute;
begin
  ClearErrors;
  ListStream.Clear;
  Extra := 1;

  { if there is a file name then load the file }
  if Trim(SourceFileName) <> '' then
  begin
    GetScanner.SrcStream.Clear;
    GetScanner.SrcStream.LoadFromFile(SourceFileName);
  end;

  { install error reporting procedure }
  GetScanner.ScannerError := StoreError;

  if Assigned(OnStatusUpdate) then
    OnStatusUpdate(Self,'parsing source',-1);

  { instigate the compilation }
  if Assigned(BeforeParse) then
    BeforeParse(Self);
  Parse;
  if Assigned(AfterParse) then
    AfterParse(Self);

  { generate the source listing to the ListStream }
  if (GenListWhen = glAlways) OR ((GenListWhen = glOnError) AND (ErrorList.Count > 0)) then
    GenerateListing;
  if ClearSourceStream then
    GetScanner.SrcStream.Clear;
  ListStream.Position := 0;  // goto the beginning of the stream
  if Successful AND Assigned(OnSuccess) then
    OnSuccess(Self);
  if (NOT Successful) AND Assigned(OnFailure) then
    OnFailure(Self, ErrorList.Count);
end;  {Execute}

procedure TDLGCodes.Get;
begin
  repeat

if GetScanner.fLastCommentList.Count > 0 then
begin
  if Assigned(fInternalGrammarComment) then
    fInternalGrammarComment(Self,GetScanner.fLastCommentList);
  GetScanner.fLastCommentList.Clear;
end;

    GetScanner.Get(fCurrentInputSymbol);
    if fCurrentInputSymbol <= maxT then
      errDist := errDist + 1
    else
    begin
    end;
  until fCurrentInputSymbol <= maxT;
end;  {Get}

function TDLGCodes.GetScanner : TDLGCodesScanner;
begin
  Result := Scanner AS TDLGCodesScanner;
end; {GetScanner}

function TDLGCodes._In(var s : SymbolSet; x : integer) : boolean;
begin
  _In := x mod setsize in s[x div setsize];
end;  {_In}

procedure TDLGCodes._DLGCodes;begin
_ResultCode;
while (fCurrentInputSymbol = RESULTCODESym) do begin
_ResultCode;
end;
end;

procedure TDLGCodes._ResultCode;begin
Expect(RESULTCODESym);
Expect(_stringSym);
writeln('result  code:  ',parse_string(lexstring)  );
Expect(USAGESym);
Expect(_equalSym);
Expect(_lparenSym);
_UsageDefinition;
while (fCurrentInputSymbol = _commaSym) do begin
Get;
_UsageDefinition;
end;
Expect(_rparenSym);
Expect(DESCRIPTIONSym);
Expect(_equalSym);
Expect(_stringSym);
writeln('description:  ',parse_string(lexstring)  );
Expect(PARAMSSym);
Expect(_equalSym);
Expect(numberSym);
writeln('number  of  params:  ',lexstring);
Expect(FORMATSym);
Expect(_equalSym);
Expect(_lparenSym);
Expect(CMDSym);
if (fCurrentInputSymbol = _lbraceSym) then begin
_operators;
end;
if (fCurrentInputSymbol = PARAM_oneSym) then begin
Get;
end;
if (fCurrentInputSymbol = PARAM_twoSym) then begin
Get;
end;
Expect(_rparenSym);
Expect(_semicolonSym);
end;

procedure TDLGCodes._operators;begin
Expect(_lbraceSym);
_operator;
while (fCurrentInputSymbol = _commaSym) do begin
Get;
_operator;
end;
Expect(_rbraceSym);
end;

procedure TDLGCodes._operator;begin
if (fCurrentInputSymbol = _lessSym) then begin
Get;
end else if (fCurrentInputSymbol = _greaterSym) then begin
Get;
end else if (fCurrentInputSymbol = _plusSym) then begin
Get;
end else if (fCurrentInputSymbol = _minusSym) then begin
Get;
end else begin SynError(29);
end;
writeln('operator:  ',lexstring);
end;

procedure TDLGCodes._UsageDefinition;begin
if (fCurrentInputSymbol = PCSym) then begin
Get;
end else if (fCurrentInputSymbol = NPCSym) then begin
Get;
end else begin SynError(30);
end;
writeln('USAGE:',lexstring);
if GetScanner.fLastCommentList.Count > 0 then
begin
  if Assigned(fInternalGrammarComment) then
    fInternalGrammarComment(Self,GetScanner.fLastCommentList);
  GetScanner.fLastCommentList.Clear;
end;
end;

