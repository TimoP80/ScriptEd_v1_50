  106  
  107  IGNORE CASE
  108  
  109  CHARACTERS
  110    letter   = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz" .
  111    digit    = "0123456789" .
  112    hexdigit = digit + "ABCDEFabcdef" .
  113    tab      = CHR(9) .
  114    lf       = CHR(10) .
  115    eol      = CHR(13) .
  116    files    = letter + digit + ":\." .
  117    chars    = CHR(32) .. CHR(255) - "'" .
  118    strings  = CHR(32) .. CHR(255) - '"'.
  119    mesentrys  = CHR(13) + CHR (10) +  CHR(32) .. CHR(255) - '{' - '}'.
  120    macros   = ANY - eol .
  121  
  122  COMMENTS FROM "//" TO eol
  123  
  124  IGNORE
  125    tab + eol + lf
  126  
  127  TOKENS
  128    identifier = ( "_" | letter) { "_" | letter | digit } .
  129    number     = digit { digit } [ "." { digit }] [ "U" | "u" | "L" | "l" ] .
  130    hexnumber  = "0" ( "x" | "X" ) hexdigit { hexdigit } [ "U" | "u" | "L" | "l" ] .
  131    _string     = '"' { strings } '"' .
  132    _mesentry = "{" { ["#"] mesentrys } "}" .
  133    char       = "'" [ "\" ] chars "'" .
  134    library    = "<" files { files } ">" .
  135    endofline = eol.
  136  
  137  IGNORE CHR(1)..CHR(32)
  138  
