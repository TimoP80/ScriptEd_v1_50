   80                                   
   81  function parse_string(zstr: string): string;
   82  var t:    integer;
   83  var temp: string;
   84  var len:  integer;
   85  begin;
   86  result:='';
   87    len := 0;
   88  temp:='';
   89    //writeln ('Parsing string: ',zstr);
   90    t   := pos('{', zstr) + 1;
   91    len := length(zstr);
   92    while (zstr[t] <> '}') do
   93    begin;
   94      //writeln (zstr[t]);
   95  
   96        temp := temp + zstr[t];
   97  
   98      Inc(t);
   99    end;
  100    Result := temp;
  101  end;
