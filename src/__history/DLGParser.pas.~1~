    dlgwriter.Add('// ' + header);
  end;
  floatmessagecounter := 0;
  for t := 0 to dlgdata.nodecount - 1 do
  begin

    if dlgdata.nodes[t].isfloatmessage = True then
      floatmessagecounter := floatmessagecounter + 1;

