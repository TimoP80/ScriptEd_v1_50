  Result := Scanner as TDLGParserScanner;
end; {GetScanner}

function TDLGParser._In(var s: SymbolSet; x: Integer): Boolean;
begin
  _In := x mod setsize in s[x div setsize];
end;  {_In}

procedure TDLGParser._DLGParser;
begin
  CurrentDialogue.entrycnt := 0;

  _DLGEntry;
  while (fCurrentInputSymbol = _mesentrySym) do
  begin
    _DLGEntry;
  end;

  GenerateDialogueNodes;
end;

procedure TDLGParser._DLGEntry;
var
  mesfieldsdetected: Integer;
  i: Integer;
begin
  mesfieldsdetected := 0;
  setlength(CurrentDialogue.entries, CurrentDialogue.entrycnt + 1);
  new(CurrentDialogue.entries[CurrentDialogue.entrycnt]);
  CurrentDialogue.entries[CurrentDialogue.entrycnt].beforeline_comments := TCommentList.Create;
  while fCurrentInputSymbol = identifierSym do
  begin
    Get;
    consoledebug('Skipping extra junk "' + lexstring + '"', False);
  end;
  if GetScanner.fLastCommentList.Count > 0 then
  begin
    //     writeln('before  line  comments:  ',  GetScanner.fLastCommentList.Text);
    for  i := 0 to GetScanner.fLastCommentList.Count - 1 do
    begin
      //   consoledebug('Line pos ' + IntToStr(GetScanner.fLastCommentList.Line[i]) + ' column ' +
      //    IntToStr(GetScanner.fLastCommentList.Column[i]));
      if GetScanner.fLastCommentList.Column[i] = 1 then
        CurrentDialogue.entries[CurrentDialogue.entrycnt].beforeline_comments.Add(GetScanner.fLastCommentList.Comments[i],
          GetScanner.fLastCommentList.Line[i], GetScanner.fLastCommentList.Column[i])
      else
      begin
        // consoledebug('Comment was at the fucking elsewhere than start of line');
        //  consoledebug('ADDING TO PREVIOSU LINE ');
        CurrentDialogue.entries[CurrentDialogue.entrycnt - 1].beforeline_comments.Add(GetScanner.fLastCommentList.Comments[i],
          GetScanner.fLastCommentList.Line[i], GetScanner.fLastCommentList.Column[i]);

      end;

    end;


    if Assigned(fInternalGrammarComment) then
      fInternalGrammarComment(Self, GetScanner.fLastCommentList);
    GetScanner.fLastCommentList.Clear;
  end;



  Expect(_mesentrySym);

  if IsStrANumber(parse_string(lexstring)) then
    CurrentDialogue.entries[CurrentDialogue.entrycnt].index := StrToInt(parse_string(lexstring))
  else
  begin
    consoledebug('DLGParser - Warning: Encountered a blank dialogue line at line ' + IntToStr(getscanner.CurrLine));
    if CurrentDialogue.entrycnt > 1 then
      CurrentDialogue.entries[CurrentDialogue.entrycnt].index := CurrentDialogue.entries[CurrentDialogue.entrycnt - 1].index;
  end;


  Inc(mesfieldsdetected);




  Expect(_mesentrySym);

  CurrentDialogue.entries[CurrentDialogue.entrycnt].field1 := parse_string(lexstring);
  Inc(mesfieldsdetected);


  Expect(_mesentrySym);

  CurrentDialogue.entries[CurrentDialogue.entrycnt].field2 := parse_string(lexstring);
  Inc(mesfieldsdetected);


  Expect(_mesentrySym);

  CurrentDialogue.entries[CurrentDialogue.entrycnt].field3 := parse_string(lexstring);
  Inc(mesfieldsdetected);


  Expect(_mesentrySym);

  CurrentDialogue.entries[CurrentDialogue.entrycnt].field4 := parse_string(lexstring);
  Inc(mesfieldsdetected);



  Expect(_mesentrySym);

  CurrentDialogue.entries[CurrentDialogue.entrycnt].field5 := parse_string(lexstring);
  Inc(mesfieldsdetected);

  Expect(_mesentrySym);

  CurrentDialogue.entries[CurrentDialogue.entrycnt].field6 := parse_string(lexstring);
  Inc(mesfieldsdetected);

  // same thing here - extra junk -> GONE!
  while fCurrentInputSymbol = identifierSym do
  begin
    Get;
    consoledebug('Skipping extra junk "' + lexstring + '" at line ' + IntToStr(
      CurrentDialogue.entries[CurrentDialogue.entrycnt].index), False);
  end;
  Inc(CurrentDialogue.entrycnt);

end;

