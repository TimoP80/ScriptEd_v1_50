function parse_string(zstr: String): String;
var
  t: Integer;
var
  temp: String;
var
  len: Integer;
begin
  Result := '';
  len  := 0;
  temp := '';
  try
    //writeln ('Parsing string: ',zstr);
    t := pos('{', zstr) + 1;
    len := length(zstr);
    while (zstr[t] <> '}') do
    begin
      //writeln (zstr[t]);
      temp := temp + zstr[t];
      Inc(t);
    end;
    Result := temp;
  except
    on e: Exception do
    begin
      MessageDlg('ERROR WHILE PARSING DIALOGUE ENTRY! string=' + zstr, mtError, [mbOK], 0);
    end;
  end;

end;



