unit OllamaLib;

interface

uses
  System.SysUtils, System.Classes, winapi.windows,System.JSON, System.Net.HttpClient, System.Net.URLClient, System.Net.HttpClientComponent;

type
  TOllamaLocalAPI = class
  private
    FBaseUrl: string;
    FHttpClient: TNetHTTPClient; // Correct class for HTTP communication
   function SendGetRequest(const Endpoint: string; out ResponseContent: string): Boolean;
  public
    constructor Create(const ABaseUrl: string);
    destructor Destroy; override;
   function ListLocalModels: TStringList;
  function GenerateText(const Model, Prompt: string): string;
    function IsServerRunning: Boolean;
  end;

implementation

{ TOllamaLocalAPI }

constructor TOllamaLocalAPI.Create(const ABaseUrl: string);
begin
  inherited Create;
  FBaseUrl := ABaseUrl;
  FHttpClient := TNetHTTPClient.Create(nil); // Ensure HTTP client is properly created
end;

destructor TOllamaLocalAPI.Destroy;
begin
  FHttpClient.Free; // Free the HTTP client to avoid memory leaks
  inherited;
end;



function TOllamaLocalAPI.SendGetRequest(const Endpoint: string; out ResponseContent: string): Boolean;
var
  HttpClient: THttpClient;
  Response: IHTTPResponse;
begin
  Result := False;
  HttpClient := THttpClient.Create;
  try
    try
      Response := HttpClient.Get(FBaseUrl + Endpoint);
      if Response.StatusCode = 200 then
      begin
        ResponseContent := Response.ContentAsString(TEncoding.UTF8);
        Result := True;
      end
      else
        ResponseContent := Format('Error: %d - %s', [Response.StatusCode, Response.StatusText]);
    except
      on E: Exception do
        ResponseContent := 'Exception: ' + E.Message;
    end;
  finally
    HttpClient.Free;
  end;
end;

function TOllamaLocalAPI.IsServerRunning: Boolean;
var
  ResponseContent: string;
begin
  // Check the server status by hitting the base endpoint or a known health endpoint
  Result := SendGetRequest('/', ResponseContent); // Base endpoint
end;


function TOllamaLocalAPI.ListLocalModels: TStringList;
var
  Response: IHTTPResponse;
  ResponseStr: string;
  ResponseJson: TJSONValue;
  TagsArray: TJSONArray;
  TagObject: TJSONObject;
  ModelName: string;
  i: Integer;
begin
  Result := TStringList.Create;
  try
    // Send GET request to the Ollama server to list available models
    Response := FHttpClient.Get(FBaseUrl + '/api/tags');

    // Get the response body as a string
    ResponseStr := Response.ContentAsString(TEncoding.UTF8);

    // Log the raw response for debugging

    // Handle empty or non-JSON responses
    if ResponseStr.Trim.IsEmpty then
    begin
      Result.Add('Error: Response body is empty.');
      Exit;
    end;

    // Parse the JSON response
    try
      ResponseJson := TJSONObject.ParseJSONValue(ResponseStr);
      if Assigned(ResponseJson) and (ResponseJson is TJSONObject) then
      begin
        // Extract the "tags" array (adjust based on actual response structure)
        TagsArray := (ResponseJson as TJSONObject).GetValue<TJSONArray>('models');

        // If tags array is available, extract each model name
        if Assigned(TagsArray) then
        begin
          for i := 0 to TagsArray.Count - 1 do
          begin
            TagObject := TagsArray.Items[i] as TJSONObject;
            if Assigned(TagObject) then
            begin
              ModelName := TagObject.GetValue<string>('model');  // Assuming "model" is the field name
              if ModelName.Trim <> '' then  // Skip empty model names
                Result.Add(ModelName);
            end;
          end;
        end
        else
        begin
          Result.Add('Error: No models found in response.');
        end;
      end
      else
      begin
        Result.Add('Error: JSON structure unexpected or missing "tags" key.');
      end;
    finally
      ResponseJson.Free;
    end;
  except
    on E: Exception do
      Result.Add('Error: ' + E.Message);
  end;
end;

function TOllamaLocalAPI.GenerateText(const Model, Prompt: string): string;
var
  Response: IHTTPResponse;
  RequestJson: TJSONObject;
  ResponseJson: TJSONValue;
  ResponseStr: string;
  ErrorMessage: string;
  StringList: TStringList;
begin
  Result := '';
  try
    // Create the JSON request body
    RequestJson := TJSONObject.Create;
    try
      RequestJson.AddPair('model', Model);
      RequestJson.AddPair('prompt', Prompt);
      RequestJson.AddPair('stream', TJSONFalse.Create);  // Pass stream as boolean false

      // Send POST request to the Ollama server with the stream parameter
      Response := FHttpClient.Post(
        FBaseUrl + '/api/generate',
        TStringStream.Create(RequestJson.ToString, TEncoding.UTF8),
        nil,
        [TNameValuePair.Create('Content-Type', 'application/json')]
      );

      // Read the raw response content
      ResponseStr := Response.ContentAsString(TEncoding.UTF8);
      // Handle empty or non-JSON responses
      if ResponseStr.Trim.IsEmpty then
      begin
        Result := 'Error: Response body is empty.';
        Exit;
      end;

      if not ResponseStr.StartsWith('{') then
      begin
        Result := ResponseStr; // Plain text response
        Exit;
      end;

      // Parse the JSON response
      try
        ResponseJson := TJSONObject.ParseJSONValue(ResponseStr);
        if Assigned(ResponseJson) and (ResponseJson is TJSONObject) then
        begin


          // Extract the "output" field (or adjust based on your response structure)
          Result := (ResponseJson as TJSONObject).GetValue<string>('response');

          // Preserve line breaks in the output (if any)
          StringList := TStringList.Create;
          try
            StringList.Text := Result;  // Load the result into TStringList
            Result := StringList.Text;  // StringList will handle newlines correctly
          finally
            StringList.Free;
          end;
        end
        else
        begin
          Result := 'Error: JSON structure unexpected or missing key "output".';
        end;
      finally
        ResponseJson.Free;
      end;
    finally
      RequestJson.Free;
    end;
  except
    on E: Exception do
      Result := 'Error: ' + E.Message;
  end;
end;
end.
