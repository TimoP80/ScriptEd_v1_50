procedure AddScriptLineRef(linenum: integer; orig: integer; new: integer;
  line_type: integer; scrdata: scrline);
begin
  setlength(scriptlinerefs, scriptlinerefcount + 1);
  scriptlinerefs[scriptlinerefcount].linenum := linenum;
  scriptlinerefs[scriptlinerefcount].line_call_orig := orig;
  scriptlinerefs[scriptlinerefcount].line_call_new := new;
  scriptlinerefs[scriptlinerefcount].line_data_orig := scrdata;
  scriptlinerefs[scriptlinerefcount].line_type := line_type;
  Inc(scriptlinerefcount);
end;

//
// This is a universal function that parses an opcode line
// and uses prompts accordingly on per parameter basis
// Easier to do it like this than have the code duplicated for
// Script->Action, Script->Condition and Script->Condition + Statement
//

function ParseOpcodeLine(line: string; iscondition: boolean): string;
var
  temp: string;
  cmd: string;
  opcode: integer;
  i: integer;
  prmtype: integer;
  paramcount: integer;
  replacestr: string;
begin
  temp := line;
  cmd := temp;
  paramcount := GetOpcodeParamCount(temp);
  if iscondition then
    opcode := GetMesIDByString(temp, ConditionOpcodes)
  else
    opcode := GetMesIDByString(temp, ActionOpcodes);

  i := 1;
  while i <= paramcount do
  begin
    prmtype := GetOpcodeParamType(i, cmd);
    case prmtype of
      PARAM_TYPE_OBJ:
        begin
          replacestr := SelectFocus;
          temp := stringreplace(temp, '(obj)', replacestr, []);
        end;
      PARAM_TYPE_NUM:
        begin
          if iscondition = True then
          begin
            if (opcode = SC_GLOBAL_FLAG_NUM_IS_SET) then
              replacestr := SelectGlobalFlag
            else

              replacestr := SelectValue;
            temp := stringreplace(temp, '(num)', replacestr, []);

          end
          else
          begin
            if (opcode = SA_SET_GLOBAL_FLAG) or (opcode = SA_CLEAR_GLOBAL_FLAG)
            then
              replacestr := SelectGlobalFlag
            else if (opcode = SA_SET_RUMOR) then
            begin
              replacestr := SelectRumor;
            end
            else if (opcode = SA_SET_GLOBAL_QUEST_STATE) then
            begin
              if i = 1 then
                replacestr := SelectQuest
              else if i = 2 then
                replacestr := SelectQuestState;
            end
            else if (opcode = SA_SET_PC_QUEST_STATE) then
            begin
              if i = 2 then
                replacestr := SelectQuest
              else if i = 3 then
                replacestr := SelectQuestState;
            end
            else

              replacestr := SelectValue;
            temp := stringreplace(temp, '(num)', replacestr, []);
          end;

        end;
    end;
    Inc(i);
  end;
  Result := temp;
end;

