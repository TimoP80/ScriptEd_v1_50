procedure TMainForm.SynCompletionProposal1CodeCompletion(Sender: TObject;
  var Value: string; Shift: TShiftState; Index: integer; EndToken: char);
var
  temp, replacestr: ansistring;
  opcode, prmtype, i, paramcount: integer;
  iscondition: boolean;
begin
  temp := Value;
  paramcount := GetOpcodeParamCount(temp);
  opcode := GetMesIDByString(temp, ActionOpcodes);
  iscondition := False;
  if opcode = -1 then
  begin
    opcode := GetMesIDByString(temp, ConditionOpcodes);
    iscondition := True;
  end;
  i := 1;
  while i <= paramcount do
  begin
    prmtype := GetOpcodeParamType(i, temp);
    case prmtype of
      PARAM_TYPE_OBJ:
        begin
          replacestr := SelectFocus;
          Value := stringreplace(Value, '(obj)', replacestr, []);
        end;
      PARAM_TYPE_NUM:
        begin
          if iscondition = True then
          begin
            if (opcode = SC_GLOBAL_FLAG_NUM_IS_SET) then
              replacestr := SelectGlobalFlag
            else

              replacestr := SelectValue;
            Value := stringreplace(Value, '(num)', replacestr, []);

          end
          else
          begin
            if (opcode = SA_SET_GLOBAL_FLAG) or (opcode = SA_CLEAR_GLOBAL_FLAG)
            then
              replacestr := SelectGlobalFlag
            else if (opcode = SA_SET_RUMOR) then
            begin
              replacestr := SelectRumor;
            end
            else if (opcode = SA_SET_GLOBAL_QUEST_STATE) then
            begin
              if i = 1 then
                replacestr := SelectQuest
              else if i = 2 then
                replacestr := SelectQuestState;
            end
            else if (opcode = SA_SET_PC_QUEST_STATE) then
            begin
              if i = 2 then
                replacestr := SelectQuest
              else if i = 3 then
                replacestr := SelectQuestState;
            end
            else

              replacestr := SelectValue;
            Value := stringreplace(Value, '(num)', replacestr, []);
          end;

        end;
    end;
    Inc(i);
  end;

end;

end.
