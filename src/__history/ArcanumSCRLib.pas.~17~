procedure ParseTextScript(filename: String; var parseresult: Boolean);
var
  i, linecounter, failedlines, charcnt, strwalkpos: Integer;
  input: TStrings;
  temp_result: Boolean;
  line, thestring, comment: AnsiString;
begin
  errorlist.Clear;
  input := TStringList.Create;
  input.LoadFromFile(filename);
  input.Add('');  // Add empty string to handle the last line

  linecounter := 0;
  failedlines := 0;
  line := '';

  for i := 0 to input.Count - 1 do
  begin
    Application.ProcessMessages;
    thestring := input[i];

    // Handle description
    if Pos('description', thestring) > 0 then
    begin
      strwalkpos := Pos('"', thestring) + 1;
      charcnt := 0;
      while (thestring[strwalkpos] <> '"') and (charcnt < 40) do
      begin
        currentscript.Description[charcnt] := thestring[strwalkpos];
        Inc(strwalkpos);
        Inc(charcnt);
      end;
      if charcnt >= 40 then
        ConsoleDebug('WARNING! Script description was truncated because it was too long!');
    end

    // Handle MAX_LINES_ALLOCATED, which should not be parsed as a script line
    else if Pos('MAX_LINES_ALLOCATED', uppercase(thestring)) > 0 then
    begin
      // Handle the MAX_LINES_ALLOCATED line here
      // If you want to store or process this line, you can do so
      // For now, we're just skipping it
    end

    // Handle comments
    else if Pos('//', thestring) = 1 then
    begin
      comment := Copy(thestring, 3, Length(thestring) - 2);
      AddScriptComment(linecounter, comment);
    end

    // Handle lines with script numbers (e.g., 0., 1., 2.)
    else if (Pos('.', thestring) >= 2) and (Pos('.', thestring) < 6) then
    begin
      line := Trim(Copy(thestring, Pos('.', thestring) + 2, Length(thestring)));
      if Pos('if', lowercase(line)) = 0 then
      begin
        SetLength(currentscript.ScriptLines, linecounter + 1);
        New(currentscript.scriptlines[linecounter]);
        ParseScriptLine(line, currentscript.scriptlines[linecounter]^, temp_result, linecounter);
        if not temp_result then Inc(failedlines);
        Inc(linecounter);
      end;
    end

    // Handle script lines without a number but containing commands (e.g., 'dialog 1', 'return and SKIP default')
    else if (Pos('.', thestring) = 0) and (Length(Trim(thestring)) > 0) then
    begin
      // These are valid script lines without numbers (like 'dialog 1', 'return and SKIP default')
      SetLength(currentscript.ScriptLines, linecounter + 1);
      New(currentscript.scriptlines[linecounter]);
      ParseScriptLine(thestring, currentscript.scriptlines[linecounter]^, temp_result, linecounter);
      if not temp_result then Inc(failedlines);
      Inc(linecounter);
    end

    // Handle lines containing keywords like 'then', 'else', or 'if' but without a script number
    else if (Pos('.', thestring) = 0) and (i > 2) then
    begin
      line := line + thestring + #13#10;

      if (Pos('then', lowercase(line)) > 0) and (Pos('else', lowercase(thestring)) = 0) then
      begin
        // If only 'then' is found, parse the current line and reset
        SetLength(currentscript.ScriptLines, linecounter + 1);
        New(currentscript.scriptlines[linecounter]);
        ParseScriptLine(line, currentscript.scriptlines[linecounter]^, temp_result, linecounter);
        if not temp_result then Inc(failedlines);
        line := '';
        Inc(linecounter);
      end
      else if (Pos('then', lowercase(line)) > 0) and (Pos('else', lowercase(line)) > 0) then
      begin
        // Handle IF-THEN-ELSE block and parse
        SetLength(currentscript.ScriptLines, linecounter + 1);
        New(currentscript.scriptlines[linecounter]);
        ParseScriptLine(line, currentscript.scriptlines[linecounter]^, temp_result, linecounter);
        if not temp_result then Inc(failedlines);
        line := '';
        Inc(linecounter);
      end;
    end

    // Handle non-script lines or empty lines (can be skipped)
    else if (Pos('.', thestring) = 0) and (theString <> '') then
     begin
      SetLength(currentscript.ScriptLines, linecounter + 1);
      New(currentscript.scriptlines[linecounter]);
      ParseScriptLine(thestring, currentscript.scriptlines[linecounter]^, temp_result, linecounter);
      if not temp_result then Inc(failedlines);
      line := '';
      Inc(linecounter);
    end;
  end;

  // Finalize script line count and error handling
  currentscript.LineCount := linecounter;
  if currentscript.LineCount < 10 then
    currentscript.MaxLinesAllocated := 10
  else
    currentscript.MaxLinesAllocated := Trunc(SimpleRoundTo(currentscript.LineCount + 4, 1));

  parseresult := failedlines = 0;
  input.Free;
end;
