  procedure HandlePCVariable(var thescrline: scrline; var paramcounter: Integer; varindex: Integer; pcvarfocus: String);
begin
  thescrline.VarTypes[paramcounter] := VT_PC_VARIABLE;
  thescrline.VarValue[paramcounter] := Makelong(varindex, GetMesIDByString(pcvarfocus, FocusData));
  Inc(paramcounter);
end;

procedure HandlePCFlag(var thescrline: scrline; var paramcounter: Integer; varindex: Integer; pcvarfocus: String);
begin
  thescrline.VarTypes[paramcounter] := VT_PC_FLAG;
  thescrline.VarValue[paramcounter] := Makelong(varindex, GetMesIDByString(pcvarfocus, FocusData));
  Inc(paramcounter);
end;

procedure HandleLocal(var thescrline: scrline; var paramcounter: Integer; currentword: String; localIndex: Integer);
begin
  if currentword = 'Local Object' then
  begin
    thescrline.VarTypes[paramcounter] := VT_LOCAL_OBJECT;
    thescrline.VarValue[paramcounter] := localIndex;
  end
  else
  begin
    thescrline.VarTypes[paramcounter] := VT_LOCAL_VARIABLE;
    thescrline.VarValue[paramcounter] := localIndex;
  end;
  Inc(paramcounter);
end;

procedure HandleGlobal(var thescrline: scrline; var paramcounter: Integer; gType: String; gIndex: Integer);
begin
  if gType = 'Flag' then
    thescrline.VarTypes[paramcounter] := VT_GLOBAL_FLAG
  else if gType = 'Variable' then
    thescrline.VarTypes[paramcounter] := VT_GLOBAL_VARIABLE;

  thescrline.VarValue[paramcounter] := gIndex;
  Inc(paramcounter);
end;

procedure HandleNumber(var thescrline: scrline; var paramcounter: Integer; numValue: Integer);
begin
  thescrline.VarTypes[paramcounter] := VT_NUMBER;
  thescrline.VarValue[paramcounter] := numValue;
  Inc(paramcounter);
end;

procedure SetParams(sourcestring: String; messagedata: messagefile; var thescrline: scrline);
var
  dest, currentword, prevword, lookahead, pcvarfocus: String;
  paramcounter, wordcnt, t, varindex: Integer;
  	x, ct, tmp1, tmp2: Integer;
begin
  try
    dest := sourcestring;
    paramcounter := 0;
    wordcnt := WordCount(dest, [':', ' ', ',']);
    t := 1;

    while t <= wordcnt do
    begin
      currentword := extractword(t, dest, [':', ' ', ',']);
      prevword := extractword(t - 1, dest, [':', ' ', ',']);
      lookahead := extractword(t + 1, dest, [':', ' ', ',']);
       	ct := t; // Save current word#

      // Handle PC Variable
      if (currentword = 'PC') and (lookahead = 'Variable') then
      begin
        varindex := StrToInt(extractword(t + 2, dest, [':', ' ', ',']));
        pcvarfocus := extractword(t + 4, dest, [':', ' ', ',']);
        HandlePCVariable(thescrline, paramcounter, varindex, pcvarfocus);
        Inc(t, 4);
      end
      // Handle PC Flag
      else if (currentword = 'PC') and (lookahead = 'Flag') then
      begin
        varindex := StrToInt(extractword(t + 2, dest, [':', ' ', ',']));
        pcvarfocus := extractword(t + 4, dest, [':', ' ', ',']);
        HandlePCFlag(thescrline, paramcounter, varindex, pcvarfocus);
        Inc(t, 4);
      end
      // Handle transform Attachee
      else if (currentword = 'Attachee') and (prevword = 'transform') then
      begin
        Dec(paramcounter); // Special case
      end
      // Handle Local Variables
      else if currentword = 'Local' then
      begin
        if lookahead = 'Object' then
        begin
          currentword := 'Local Object';
          HandleLocal(thescrline, paramcounter, currentword, StrToInt(extractword(t + 2, dest, [':', ' ', ','])));
          Inc(t, 3);
        end
        else
        begin
          HandleLocal(thescrline, paramcounter, currentword, StrToInt(extractword(t + 1, dest, [':', ' ', ','])));
          Inc(t, 2);
        end;
      end
      // Handle Global Variables
      else if currentword = 'Global' then
      begin
        HandleGlobal(thescrline, paramcounter, lookahead, StrToInt(extractword(t + 2, dest, [':', ' ', ','])));
        Inc(t, 3);
      end
      // Handle Numbers
      else if IsStrANumber(currentword) then
      begin
        HandleNumber(thescrline, paramcounter, StrToInt(currentword));
      end;

       for x := 0 to FocusData.entrycnt - 1 do
			begin
    	  	tmp1 := WordPosition(t, dest, [':', ' ', ',']);  // postprocessing word position
				tmp2 := WordPosition(ct, dest, [':', ' ', ',']); // original (preprocessing) word position
				if ((pos(focusdata.entries[x].messagestr, dest) = tmp1) and (tmp1 > 0) and // make certain current word is one of the focus MES entries and
					(pos('PC Variable', dest) <> tmp2) and (pos('PC Flag', dest) <> tmp2)) then // the original current phrase wasn't PC Variable or PC Flag
				//if ((pos(focusdata.entries[x].messagestr, dest) = WordPosition(t, dest, [':', ' ', ','])) and
				//	(WordPosition(t, dest, [':', ' ', ',']) > 0) and (pos('PC Variable', dest) = 0) and (pos('PC Flag', dest) = 0)) then
				begin
       		thescrline.VarTypes[paramcounter] := focusdata.entries[x].index;
					//if thescrline.VarTypes[paramcounter] = 11 then
					//begin
					//  thescrline.VarValue[paramcounter] := 0;
					//end;

					thescrline.VarValue[paramcounter] := 0;
					Inc(paramcounter);
					// Inc(t, wordcount(focusdata.entries[t].messagestr, [' ']));
					dest := StringReplace(dest, focusdata.entries[x].messagestr, '(obj)', []);
					wordcnt := WordCount(dest, [':', ' ', ',']); // Might have changed.
					break;
				end;
			end;

      Inc(t);
    end;

  except
    on e: Exception do
      consoledebug('Exception occurred in SetParams: ' + e.message + ' Input: ' + sourcestring);
  end;
end;


