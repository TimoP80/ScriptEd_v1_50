  100  
  101  IGNORE CASE
  102  
  103  CHARACTERS
  104    letter   = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz" .
  105    digit    = "0123456789" .
  106    hexdigit = digit + "ABCDEFabcdef" .
  107    tab      = CHR(9) .
  108    lf       = CHR(10) .
  109    eol      = CHR(13) .
  110    files    = letter + digit + ":\." .
  111    chars    = CHR(32) .. CHR(255) - "'" .
  112    strings  = CHR(32) .. CHR(255) - '"'.
  113    mesentrys  = CHR(9) + CHR(13) + CHR (10) +  CHR(32) .. CHR(255) - '{' - '}'.
  114    macros   = ANY - eol .
  115  
  116  COMMENTS FROM "//" TO eol
  117  
  118  IGNORE
  119    tab + eol + lf
  120  
  121  TOKENS
  122    identifier = ( "_" | letter) { "_" | letter | digit } .
  123    number     = digit { digit } [ "." { digit }] [ "U" | "u" | "L" | "l" ] .
  124    hexnumber  = "0" ( "x" | "X" ) hexdigit { hexdigit } [ "U" | "u" | "L" | "l" ] .
  125    _string     = '"' { strings } '"' .
  126    _mesentry = "{" { ["#"] mesentrys } "}" .
  127    char       = "'" [ "\" ] chars "'" .
  128    library    = "<" files { files } ">" .
  129    endofline = eol.
  130  
  131  IGNORE CHR(1)..CHR(32)
