   74                                   
   75  function parse_string(zstr: string): string;
   76  var t:    integer;
   77  var temp: string;
   78  var len:  integer;
   79  begin;
   80  result:='';
   81    len := 0;
   82  temp:='';
   83    //writeln ('Parsing string: ',zstr);
   84    t   := pos('{', zstr) + 1;
   85    len := length(zstr);
   86    while (zstr[t] <> '}') do
   87    begin;
   88      //writeln (zstr[t]);
   89  
   90        temp := temp + zstr[t];
   91  
   92      Inc(t);
   93    end;
   94    Result := temp;
   95  end;
