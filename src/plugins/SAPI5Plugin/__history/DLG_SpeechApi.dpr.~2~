  Classes,
  pluginfunc,
  Dialogs,
  SpeechLib_TLB,
  OleServer,
  SAPIContainerUnit in 'SAPIContainerUnit.pas' {SAPIContainer: TDataModule};

{$R *.res}

 // This function should return the name of the plugin to be
